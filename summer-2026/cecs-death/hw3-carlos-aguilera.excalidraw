      "version": 73,
      "versionNonce": 65535616,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785606236248,
      "link": null,
      "locked": false,
      "text": "Ms(t) = (Mx(t))^n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ms(t) = (Mx(t))^n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "a56xjZhjrZs11gvWafsQ4",
      "type": "text",
      "x": 9310.281808633157,
      "y": 13377.848602843556,
      "width": 232.8798828125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 90,
      "groupIds": [],
      "frameId": null,
      "index": "b1X",
      "roundness": null,
      "seed": 1367596672,
      "version": 197,
      "versionNonce": 1530194304,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785606238227,
      "link": null,
      "locked": false,
      "text": "Mx(t) = (1 - p + pe^t)^n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mx(t) = (1 - p + pe^t)^n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3aHnQHJPAgOS8rkCxY2h1",
      "type": "text",
      "x": 9097.654633037993,
      "y": 13477.45372819342,
      "width": 18.119979858398438,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 90,
      "groupIds": [],
      "frameId": null,
      "index": "b1Y",
      "roundness": null,
      "seed": 1564174720,
      "version": 26,
      "versionNonce": 1119705472,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785606795350,
      "link": null,
      "locked": false,
      "text": "c)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
