      "isDeleted": false,
      "boundElements": null,
      "updated": 1785607023998,
      "link": null,
      "locked": false,
      "text": "P(S >= a) <=       [e^(-ta)(1 - p + pe^t)^n]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "P(S >= a) <=       [e^(-ta)(1 - p + pe^t)^n]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XwI6p35eefgRmAnxrjdZa",
      "type": "text",
      "x": 9244.788852214007,
      "y": 16506.942291114094,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 90,
      "groupIds": [],
      "frameId": null,
      "index": "b1d",
      "roundness": null,
      "seed": 1493068160,
      "version": 5,
      "versionNonce": 1874700672,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1785607082631,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 20,
      "fontFamily": 5,
