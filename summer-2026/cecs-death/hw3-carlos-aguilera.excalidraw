      "updated": 1785607265400,
      "link": null,
      "locked": false,
      "text": "Randomized Quickselect runs in expected (O(n)) time because\nthere is a (1/2) chance of choosing a good pivot that reduces\nthe remaining problem to at most (3n/4) elements.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Randomized Quickselect runs in expected (O(n)) time because there is a (1/2) chance of choosing a good pivot that reduces the remaining problem to at most (3n/4) elements.",
      "autoResize": false,
      "lineHeight": 1.25
    },
