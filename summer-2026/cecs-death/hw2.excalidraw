      "isDeleted": false,
      "boundElements": [],
      "updated": 1785286578594,
      "link": null,
      "locked": false,
      "text": "P(X = 4) = ((1 - 0.25)^3) x 0.25 =\n\nTaking the result and making percentage gives us\n\n0.10546875 x 100 ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "P(X = 4) = ((1 - 0.25)^3) x 0.25 =\n\nTaking the result and making percentage gives us\n\n0.10546875 x 100 ",
      "autoResize": true,
      "lineHeight": 1.25
    },
