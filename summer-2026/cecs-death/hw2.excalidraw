      "isDeleted": false,
      "boundElements": null,
      "updated": 1785304965300,
      "link": null,
      "locked": false,
      "text": "Only one needs to fail so that we prove they are dependent",
      "fontSize": 19.755528585869516,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only one needs to fail so that we prove they are dependent",
