      "link": null,
      "locked": false,
      "text": "Use geometric formula: P(X = k) = ((1 - p)^k-1) x p",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use geometric formula: P(X = k) = ((1 - p)^k-1) x p",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5MUnUYs0N9or8Q8ZPzotz",
      "type": "text",
      "x": 8878.921769326276,
      "y": 12900.087244429276,
