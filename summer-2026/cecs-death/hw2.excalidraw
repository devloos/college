      "seed": 2134780168,
      "version": 345,
      "versionNonce": 1531259656,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785194598933,
      "link": null,
      "locked": false,
      "text": "4c + 3c + 2c + 1c = 1\nc(4 + 3 + 2 + 1) = 1\n10c = 1\n\ntherefore: c = ",
      "fontSize": 19.83914139739179,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4c + 3c + 2c + 1c = 1\nc(4 + 3 + 2 + 1) = 1\n10c = 1\n\ntherefore: c = ",
      "autoResize": true,
      "lineHeight": 1.25
    },
