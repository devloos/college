    {
      "id": "_si6TWGUbQDTzcFHVyiNP",
      "type": "text",
      "x": 8895.783462667323,
      "y": 10429.430674020748,
      "width": 238.139892578125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 90,
      "groupIds": [],
      "frameId": null,
      "index": "b2q",
      "roundness": null,
      "seed": 311435896,
      "version": 90,
      "versionNonce": 231107448,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785194492496,
      "link": null,
      "locked": false,
      "text": "Px(x) = c(5-x)\n\nWe plug\n\nP(X = 1) = (5 - 1)c = 4c\nP(X = 2) = (5 - 2)c = 3c\nP(X = 3) = (5 - 3)c = 2c\nP(X = 4) = (5 - 4)c = 1c",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Px(x) = c(5-x)\n\nWe plug\n\nP(X = 1) = (5 - 1)c = 4c\nP(X = 2) = (5 - 2)c = 3c\nP(X = 3) = (5 - 3)c = 2c\nP(X = 4) = (5 - 4)c = 1c",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ad7FqAs8eDJqFKc6IIWUE",
      "type": "text",
      "x": 9196.446864979094,
      "y": 10461.759639459771,
      "width": 193.0744326575922,
      "height": 24.79892674673974,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 90,
      "groupIds": [],
      "frameId": null,
      "index": "b2s",
      "roundness": null,
      "seed": 1183364360,
      "version": 318,
      "versionNonce": 1427106824,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785194598933,
      "link": null,
      "locked": false,
      "text": "They must sum to 1",
      "fontSize": 19.83914139739179,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "They must sum to 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tFQPHtFaxsZ0rq0JJBq6z",
      "type": "text",
      "x": 9205.796378881207,
      "y": 10506.372547869647,
      "width": 201.6251128923914,
      "height": 123.99463373369868,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
